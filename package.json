{
  "name": "sche10le",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.js",
    "test:live": "playwright test --config playwright.live.config.js",
    "check:live-samples": "node scripts/check-live-samples.js",
    "build:safari": "wxt build -b safari --mv3",
    "test:safari": "npm run build:safari && playwright test --config playwright.safari.config.js",
    "preview:safari": "npm run build:safari && node scripts/preview-safari.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
}
