{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "entrypoints/**/*.js",
    "lib/**/*.js",
    "types/**/*.d.ts",
    "wxt.config.js",
    ".wxt/wxt.d.ts"
  ]
}
